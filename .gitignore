# Large local datasets are kept out of version control.
data/*.csv.zip
data/*.csv

# Python caches and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
.venv/
venv/

# Local secrets and environment files.
.env
.env.*
!.env.example

# macOS metadata.
.DS_Store

# Reproducible outputs and notebook state.
artifacts/processed/*
artifacts/experiments/*
artifacts/frozen/*
!artifacts/processed/.gitkeep
!artifacts/experiments/.gitkeep
!artifacts/frozen/.gitkeep
outputs/*
!outputs/figures/
!outputs/tables/
outputs/figures/*
outputs/tables/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
.ipynb_checkpoints/
tmp/
